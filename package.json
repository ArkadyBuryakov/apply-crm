{
  "name": "apply-crm",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "check-licenses": "pnpm -r licenses list --prod --json | pnpm --silent --filter @crm/scripts check-licenses",
    "test:e2e": "pnpm --filter @crm/web build && pnpm --filter @crm/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
