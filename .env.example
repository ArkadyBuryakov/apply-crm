# Server
PORT=3000
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters
# Restricts who can claim the instance on first sign-up (ADR 0021). Optional.
BOOTSTRAP_ADMIN_EMAIL=

# Optional social login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Object storage (S3-compatible; RustFS locally, Hetzner Object Storage in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=crm-documents
S3_ACCESS_KEY_ID=devaccess
S3_SECRET_ACCESS_KEY=devsecret-devsecret
S3_FORCE_PATH_STYLE=true
